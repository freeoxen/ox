/target
/local
# Compiled guests and generated packaging provenance belong in build output,
# never in the source history. Cargo packages include them explicitly.
*.wasm
*.wasm.provenance.json
# trybuild writes unaccepted compiler diagnostics here on failed tests.
/crates/*/wip/
# LLVM coverage profile data — generated by `-C instrument-coverage`
# instrumented runs. Defense-in-depth alongside the .cargo/config.toml
# `LLVM_PROFILE_FILE` override that redirects them into target/.
*.profraw
*.swp
*.swo
node_modules
.svelte-kit
site/dist
.superpowers
.claude/scheduled_tasks.lock

.claude/worktrees/
