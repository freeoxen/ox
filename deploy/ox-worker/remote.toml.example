[exe]
control_host = "exe.dev"
control_port = 22
control_user = "your-exe-user"
worker_image = "registry.example/ox-worker@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
identity = "~/.ssh/id_ed25519_exe"
provider_known_hosts = "~/.ox/remote/provider_known_hosts"
worker_known_hosts = "~/.ox/remote/known_hosts"
worker_socket = "/run/ox/worker.sock"
connect_timeout = "10s"
operation_timeout = "30s"

[defaults]
cpu = 2
memory_mib = 4096
disk_gib = 20
